# ================================================================
# MindSenseAI Backend Environment Template
# Copy this file to `backend/.env` and fill in your keys.
# DO NOT COMMIT YOUR REAL `.env` FILE TO GIT.
# ================================================================

# --- Core LLM & Speech Inference (Required) ---
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Security & Authentication (Required) ---
# Generate a strong random key (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=your_secure_random_string_here

# --- Database Configuration (Optional: defaults to local SQLite) ---
# DATABASE_URL=sqlite:///./mindsense.db

# --- Emergency Alerts: WhatsApp via Green API (Optional) ---
# Obtain from: https://green-api.com
GREENAPI_ID_INSTANCE=your_greenapi_instance_id_here
GREENAPI_API_TOKEN=your_greenapi_token_here

# --- Emergency Alerts: SMS Gateway (Optional) ---
# App: https://github.com/capcom6/android-sms-gateway
SMS_GATE_LOGIN=your_sms_gateway_login_here
SMS_GATE_PASSWORD=your_sms_gateway_password_here

# --- Emergency Alerts: Email via Gmail SMTP (Optional) ---
# Create App Password: https://myaccount.google.com/apppasswords
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password_here

# --- Emergency Alerts: Twilio (Optional) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# --- Cloud Database: Supabase (Optional) ---
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
